# Copy this file to `.env` (same directory) and fill in your values.
# `pipeline/config.py` loads .env automatically — no shell sourcing needed.
# .env is gitignored.

# --- LLM provider ----------------------------------------------------------
# One of: mock | anthropic | openai
PIPELINE_LLM_PROVIDER=openai

# --- OpenAI ----------------------------------------------------------------
OPENAI_API_KEY=sk-REPLACE_ME

# --- Anthropic (only if PIPELINE_LLM_PROVIDER=anthropic) -------------------
# ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# --- Per-stage models -------------------------------------------------------
# Optional. If unset, every stage uses PIPELINE_LLM_MODEL.
# Typical pattern: cheaper model for planning + testgen, stronger for codegen.

# Fallback model when a stage doesn't override.
PIPELINE_LLM_MODEL=gpt-4o-mini

# Stage-specific overrides:
PIPELINE_PLAN_MODEL=gpt-4o-mini
PIPELINE_CODEGEN_MODEL=gpt-4o
PIPELINE_TESTGEN_MODEL=gpt-4o-mini

# Max output tokens per LLM call (codegen can be hefty; default 8192).
# PIPELINE_MAX_TOKENS=8192

# Optional: estimated cost metrics. Values are USD per 1M tokens.
# Per-model pricing wins over generic pricing; use current provider pricing.
# PIPELINE_LLM_PRICING_JSON={"openai/gpt-4o-mini":{"input":0.15,"output":0.60},"openai/gpt-4o":{"input":2.50,"output":10.00}}
# PIPELINE_INPUT_TOKEN_COST_PER_1M=0.15
# PIPELINE_OUTPUT_TOKEN_COST_PER_1M=0.60
# PIPELINE_CACHE_CREATION_INPUT_TOKEN_COST_PER_1M=0.00
# PIPELINE_CACHE_READ_INPUT_TOKEN_COST_PER_1M=0.00

# --- Pipeline behaviour -----------------------------------------------------
# Reviewer identity stamped on approvals.
APPROVER=you@example.com

# Prompt template version to pin for this run (subdir under pipeline/llm/prompts).
# PIPELINE_PROMPT_VERSION=v1

# Which bundled target to run against. Default is targets/flask-status; switch
# to ./targets/crud-api for the CRUD spec series.
# PIPELINE_TARGET_DIR=./targets/flask-status

# Tool-using codegen / repair agent budgets.
# PIPELINE_MAX_AGENT_TURNS=12
# PIPELINE_MAX_REPAIR_ATTEMPTS=2


# PIPELINE_LLM_PRICING_JSON={"openai/gpt-4o-mini":{"input":0.15,"output":0.60},"openai/gpt-4o":{"input":2.50,"output":10.00}}
# PIPELINE_INPUT_TOKEN_COST_PER_1M=0.15
# PIPELINE_OUTPUT_TOKEN_COST_PER_1M=0.60
